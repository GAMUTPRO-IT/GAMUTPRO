Options -Indexes
RewriteEngine On

# 301-redirect .html extensions to clean URLs
# Matches requests like /page-name.html and sends browsers to /page-name
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Serve clean URLs: if /page-name is requested and /page-name.html exists, serve it transparently
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# Custom error pages
ErrorDocument 404 /404.html
ErrorDocument 500 /404.html

# --- MAINTENANCE MODE (disabled) ---
# To activate: uncomment the three lines below, then push.
# ErrorDocument 503 /maintenance.html
# RewriteRule ^$ - [R=503,L]
